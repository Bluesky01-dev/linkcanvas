run = "npm start"
entrypoint = "server/index.js"
modules = ["nodejs-20", "web"]

[deployment]
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "node server/index.js"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm start"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
